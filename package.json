{
  "name": "obsidian-to-wechat",
  "version": "0.1.7",
  "description": "Preview, style, copy, and publish Markdown notes to multiple WeChat Official Accounts.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src",
    "test:cover": "node scripts/test-cover-crop.mjs",
    "test:render": "node scripts/test-render.mjs",
    "check": "npm run lint && npm test && npm run build && npm run test:render && npm run test:cover && node scripts/check-release.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "wechat",
    "publisher"
  ],
  "author": "Ancle",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "dompurify": "3.4.16",
    "esbuild": "0.25.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "markdown-it": "14.3.2",
    "obsidian": "1.8.7",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "moment": "^2.31.0"
  },
  "dependencies": {
    "cropperjs": "1.6.2",
    "highlight.js": "^11.11.1",
    "juice": "^11.1.0"
  }
}
